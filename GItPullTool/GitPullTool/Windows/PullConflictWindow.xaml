<Window x:Class="GitPullTool.Windows.PullConflictWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="&#x786E;&#x8BA4;&#x8FD8;&#x539F;&#x672C;&#x5730;&#x66F4;&#x6539;"
        Height="720"
        Width="1240"
        MinHeight="560"
        MinWidth="900"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Window.Resources>
        <DataTemplate x:Key="PreviewSegmentTemplate">
            <Border Padding="0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="Transparent" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsHighlighted}" Value="True">
                                <Setter Property="Background" Value="#FFD966" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <TextBlock Text="{Binding Text}"
                           FontFamily="Consolas"
                           FontSize="12"
                           TextWrapping="NoWrap"
                           VerticalAlignment="Center" />
            </Border>
        </DataTemplate>
        <DataTemplate x:Key="PreviewLineTemplate">
            <Border Padding="0" Margin="0" BorderBrush="#D7D1F0" BorderThickness="0,0,0,1">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="#FFFFFF" />
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsChanged}" Value="True">
                                <Setter Property="Background" Value="#DDD6FF" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="50" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Background="#D9DCE5">
                        <TextBlock Text="{Binding Marker}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#444" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding Marker}" Value="+">
                                            <Setter Property="Foreground" Value="#1565C0" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Marker}" Value="-">
                                            <Setter Property="Foreground" Value="#C77800" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding Marker}" Value="~">
                                            <Setter Property="Foreground" Value="#0057B8" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Border>

                    <Border Grid.Column="1" Background="#ECEEF4">
                        <TextBlock Text="{Binding LineNumberText}"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Right"
                                   Margin="0,0,4,0"
                                   Foreground="#333" />
                    </Border>

                    <Border Grid.Column="2" Background="#ECEEF4">
                        <TextBlock Text=":"
                                   FontFamily="Consolas"
                                   FontSize="12"
                                   Foreground="#666"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center" />
                    </Border>

                    <ItemsControl Grid.Column="3" ItemsSource="{Binding Segments}" ItemTemplate="{StaticResource PreviewSegmentTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </Grid>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="SummaryTextBlock"
                   Text="&#x68C0;&#x6D4B;&#x5230;&#x4EE5;&#x4E0B;&#x672C;&#x5730;&#x66F4;&#x6539;&#x4F1A;&#x88AB;&#x8986;&#x76D6;&#x3002;"
                   FontSize="15"
                   FontWeight="SemiBold" />

        <StackPanel Grid.Row="1" Margin="0,8,0,10">
            <TextBlock x:Name="RepoTextBlock" TextWrapping="Wrap" Foreground="#555" />
            <TextBlock x:Name="HintActionTextBlock"
                       Text="&#x53F3;&#x952E;&#x6587;&#x4EF6;&#x53EF;&#x5355;&#x72EC;&#x5904;&#x7406;&#x3002;"
                       Margin="0,4,0,0"
                       Foreground="#A33" />
        </StackPanel>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="340" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <GroupBox Header="&#x51B2;&#x7A81;&#x6587;&#x4EF6;" Grid.Column="0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="8" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="&#x5DF2;&#x8DDF;&#x8E2A;&#x6587;&#x4EF6;" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="RestoreTrackedButton" Content="&#x4E00;&#x952E;&#x8FD8;&#x539F;" Width="82" Margin="0,0,6,0" Click="OnRestoreTrackedAllClick" />
                                <Button x:Name="DeleteTrackedButton" Content="&#x4E00;&#x952E;&#x5220;&#x9664;" Width="82" Click="OnDeleteTrackedAllClick" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="TrackedFileList"
                                 DisplayMemberPath="DisplayText"
                                 SelectionChanged="OnSelectionChanged"
                                 MouseRightButtonUp="OnFileListRightClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="&#x8FD8;&#x539F;&#x6B64;&#x6587;&#x4EF6;" Click="OnRestoreFileClick" />
                                    <MenuItem Header="{Binding PlacementTarget.SelectedItem.DeleteActionText, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                              Click="OnDeleteFileClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Row="2">
                        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,4">
                            <TextBlock Text="&#x672A;&#x8DDF;&#x8E2A;&#x6587;&#x4EF6;" FontWeight="SemiBold" />
                            <WrapPanel Margin="0,4,0,0">
                                <Button x:Name="RestoreUntrackedButton" Content="&#x4E00;&#x952E;&#x8FD8;&#x539F;" Width="82" Margin="0,0,6,0" IsEnabled="False" />
                                <Button x:Name="DeleteUntrackedButton" Content="&#x4E00;&#x952E;&#x5220;&#x9664;" Width="82" Click="OnDeleteUntrackedAllClick" />
                            </WrapPanel>
                        </StackPanel>
                        <ListBox x:Name="UntrackedFileList"
                                 DisplayMemberPath="DisplayText"
                                 SelectionChanged="OnSelectionChanged"
                                 MouseRightButtonUp="OnFileListRightClick">
                            <ListBox.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="&#x5220;&#x9664;&#x6B64;&#x6587;&#x4EF6;" Click="OnDeleteFileClick" />
                                </ContextMenu>
                            </ListBox.ContextMenu>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </GroupBox>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" BorderBrush="#E0E0E0" BorderThickness="1" CornerRadius="4" Padding="8" Margin="0,0,0,8">
                    <StackPanel>
                        <TextBlock x:Name="DetailsTextBlock" FontWeight="SemiBold" />
                        <TextBlock x:Name="HintTextBlock" Margin="0,4,0,0" Foreground="#666" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <GroupBox x:Name="LeftGroupBox" Header="HEAD" Grid.Column="0">
                        <ScrollViewer x:Name="LeftScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      ScrollChanged="OnLeftScrollChanged">
                            <ItemsControl x:Name="LeftPreviewItems" ItemTemplate="{StaticResource PreviewLineTemplate}" />
                        </ScrollViewer>
                    </GroupBox>

                    <GroupBox x:Name="RightGroupBox" Header="Working Tree" Grid.Column="2">
                        <ScrollViewer x:Name="RightScrollViewer"
                                      VerticalScrollBarVisibility="Auto"
                                      HorizontalScrollBarVisibility="Auto"
                                      ScrollChanged="OnRightScrollChanged">
                            <ItemsControl x:Name="RightPreviewItems" ItemTemplate="{StaticResource PreviewLineTemplate}" />
                        </ScrollViewer>
                    </GroupBox>
                </Grid>
            </Grid>
        </Grid>

        <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="ConfirmButton" Content="&#x786E;&#x5B9A;" Width="88" Margin="0,0,8,0" IsDefault="True" Click="OnConfirm" />
            <Button Content="&#x53D6;&#x6D88;" Width="88" IsCancel="True" />
        </StackPanel>
    </Grid>
</Window>
